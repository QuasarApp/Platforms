#ifndef PLATFORMS_GLOBAL_H
#define PLATFORMS_GLOBAL_H

/**
 * @file global.h.in
 * @brief Global definitions and macros for Platforms library
 * 
 * This header file provides common definitions and macros used throughout
 * the Platforms library. It is processed by CMake to generate the final
 * header file with version information.
 * 
 * @note This file is used as a template and is processed by CMake.
 * @note The @PLATFORMS_VERSION@ placeholder is replaced by CMake.
 * 
 * @since 3.0.0
 */

#include <QtCore/qglobal.h>

/**
 * @brief Platforms library version string
 * 
 * This macro defines the version string for the Platforms library.
 * The value is set by CMake during the build process.
 * 
 * @example
 * QString version = Platforms::version();  // Returns "3.0.0"
 */
#define PLATFORMS_VERSION "@PLATFORMS_VERSION@"

/**
 * @brief Export macro for library symbols
 * 
 * This macro is defined when building the library and should be used
 * to export symbols from the library.
 * 
 * @note Use PLATFORMS_EXPORT in class declarations and function prototypes
 * 
 * @example
 * class PLATFORMS_EXPORT MyClass { ... };
 * void PLATFORMS_EXPORT myFunction();
 */
#if defined(PLATFORMS_LIBRARY)
#  define PLATFORMS_EXPORT Q_DECL_EXPORT
#else
#  define PLATFORMS_EXPORT Q_DECL_IMPORT
#endif

#endif //PLATFORMS_GLOBAL_H
